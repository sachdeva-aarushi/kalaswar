  "components": {
    "schemas": {
      "AuditLogCreate": {
        "properties": {
          "action": {
            "type": "string",
            "title": "Action",
            "examples": [
              "product_created"
            ]
          },
          "entity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entity",
            "examples": [
              "products"
            ]
          },
          "entity_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entity Id",
            "examples": [
              "dddddddd-0001-0000-0000-000000000001"
            ]
          },
          "payload": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payload",
            "examples": [
              {
                "price": 1200
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "AuditLogCreate"
      },
      "Body_transcribe_audio_api_v1_voice_transcribe_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_transcribe_audio_api_v1_voice_transcribe_post"
      },
      "DPPBatchRequest": {
        "properties": {
          "product_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Product Ids",
            "description": "Batch of up to 500 product IDs to aggregate into Merkle tree"
          }
        },
        "type": "object",
        "required": [
          "product_ids"
        ],
        "title": "DPPBatchRequest"
      },
      "DPPPassportResponse": {
        "properties": {
          "passport_id": {
            "type": "string",
            "format": "uuid",
            "title": "Passport Id"
          },
          "product_id": {
            "type": "string",
            "format": "uuid",
            "title": "Product Id"
          },
          "artisan_name": {
            "type": "string",
            "title": "Artisan Name"
          },
          "shg_cluster_name": {
            "type": "string",
            "title": "Shg Cluster Name"
          },
          "craft_origin": {
            "type": "string",
            "title": "Craft Origin"
          },
          "gps_coordinates": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gps Coordinates"
          },
          "wage_distribution_pct": {
            "type": "number",
            "title": "Wage Distribution Pct",
            "description": "Percentage of retail price paid to artisan",
            "default": 68.0
          },
          "merkle_root": {
            "type": "string",
            "title": "Merkle Root"
          },
          "polygon_tx_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Polygon Tx Hash"
          },
          "qr_code_url": {
            "type": "string",
            "title": "Qr Code Url"
          },
          "is_verified_on_chain": {
            "type": "boolean",
            "title": "Is Verified On Chain",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "passport_id",
          "product_id",
          "artisan_name",
          "shg_cluster_name",
          "craft_origin",
          "merkle_root",
          "qr_code_url"
        ],
        "title": "DPPPassportResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "healthy",
            "examples": [
              "healthy"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service",
            "examples": [
              "Kalaswar Core Services"
            ]
          },
          "version": {
            "type": "string",
            "title": "Version",
            "examples": [
              "3.0.0"
            ]
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "examples": [
              "development"
            ]
          },
          "database_connected": {
            "type": "boolean",
            "title": "Database Connected",
            "default": true,
            "examples": [
              true
            ]
          }
        },
        "type": "object",
        "required": [
          "service",
          "version",
