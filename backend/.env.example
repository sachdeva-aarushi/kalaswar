# Kalaswar FastAPI Backend Configuration Template
# Copy to .env and provide secrets. NEVER commit .env to version control.

# Server
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp Business / BSP (Meta / Twilio / Gupshup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Voice & AI Services
OPENAI_API_KEY=
SARVAM_API_KEY=

# Cloudinary Media Pipeline
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Blockchain / Layer-2 Provenance (Polygon / Solana)
RPC_URL=https://polygon-rpc.com
DPP_CONTRACT_ADDRESS=
MERKLE_BATCH_SIZE=500
