# ==============================================================================
# Kalaswar Core Services Backend Configuration (.env.example)
# Copy this file to .env and provide your secrets. NEVER commit .env to git.
# ==============================================================================

# Server & Project Settings
PROJECT_NAME="Kalaswar Core Services"
VERSION="3.0.0"
API_V1_STR="/api/v1"
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:8000"]

# Supabase Authentication & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Secret used to verify Supabase JWT tokens (from Supabase Dashboard -> Project Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-at-least-32-chars

# Meta WhatsApp Cloud API / Webhook Integration
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=kalaswar_dev_token

# AI & Speech Services (Whisper / Sarvam Indic Voice)
OPENAI_API_KEY=
SARVAM_API_KEY=

# Cloudinary Media Pipeline (GI Watermarking & Optimization)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Blockchain Layer-2 Provenance & Digital Product Passports (DPP)
RPC_URL=https://polygon-rpc.com
DPP_CONTRACT_ADDRESS=
MERKLE_BATCH_SIZE=500
