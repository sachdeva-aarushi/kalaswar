# Kalaswar environment variables — names only, never commit real values.
# Supabase/Cloud variables are provisioned by Lovable Cloud; listed for external deployments.

# --- Server-only (read inside server handlers; never VITE_-prefixed) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
LOVABLE_API_KEY=

# --- Browser (VITE_ prefix) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Cloudinary product image uploads (you configure these) ---
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
